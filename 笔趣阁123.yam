  "loginUrl": "",
  "bookUrlPattern": "",
  "header": "",
  "enable": true,
  "ruleSearch": {
    "bookList": "class.grid@tag.tbody@tag.tr!0",
    "name": "tag.td.0@tag.a@text",
    "author": "tag.td.2@text",
    "kind": "",
    "lastChapter": "tag.td.1@tag.a@text",
    "intro": "",
    "coverUrl": "",
    "bookUrl": "tag.td.0@tag.a@href"
  },
  "ruleBookInfo": {
    "name": "id.info@tag.h1@text",
    "author": "id.info@p.0@text##作者：",
    "kind": "id.info@p.1@text##状态：.*",
    "lastChapter": "id.info@p.4@tag.a@text",
    "intro": "id.intro@text",
    "coverUrl": "id.fmimg@tag.img@src",
    "tocUrl": "text.章节目录@href||text.正文卷@href"
  },
  "ruleToc": {
    "chapterList": "id.list@tag.dd||id.list@tag.li",
    "chapterName": "tag.a@text",
    "chapterUrl": "tag.a@href"
  },
  "ruleContent": {
    "content": "id.content@textNodes##请安装最新版本继续阅读.*|请记住本书首发域名.*|笔趣阁.*"
  },
  "ruleReview": {},
  "ruleExplore": {},
